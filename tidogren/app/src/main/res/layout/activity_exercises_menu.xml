<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="✍️ Alıştırmalar"
        android:textSize="24sp"
        android:textStyle="bold"/>

    <Button
        android:id="@+id/btnMultipleChoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Çoktan Seçmeli"/>

    <Button
        android:id="@+id/btnClassic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Klasik"/>

    <Button
        android:id="@+id/btnMatching"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Eşleştirme"/>

    <Button
        android:id="@+id/btnTrueFalse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Doğru / Yanlış"/>
</LinearLayout>

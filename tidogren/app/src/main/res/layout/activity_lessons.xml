<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- BAŞLIK -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📘 Dersler"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- DERS 1 -->
        <Button
            android:id="@+id/btnLesson1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Alfabe (A–Z)"
            android:layout_marginBottom="8dp"/>

        <!-- DERS 2 -->
        <Button
            android:id="@+id/btnLesson2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Temel Kelimeler"
            android:layout_marginBottom="8dp"/>

        <!-- DERS 3 -->
        <Button
            android:id="@+id/btnLesson3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Günlük İfadeler"
            android:layout_marginBottom="8dp"/>

        <!-- DERS 4 -->
        <Button
            android:id="@+id/btnLesson4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Cümleler"
            android:layout_marginBottom="24dp"/>

        <!-- GERİ DÖN -->
        <Button
            android:id="@+id/btnBackLessons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Geri Dön"
            android:layout_gravity="center"/>

    </LinearLayout>
</ScrollView>
